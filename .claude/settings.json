{
  "permissions": {
    "allow": [
      "Bash(bun install:*)",
      "Bash(bun run typecheck)",
      "Bash(bun run test:schemas)",
      "Bash(bun test:*)",
      "Bash(bun scripts/acceptance-traceability.ts:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin agent/:*)",
      "Bash(git push -u origin agent/:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push origin agent-work:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin feat/dashboard-profile:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
